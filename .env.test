# Entorno para pruebas e2e: usa una base de datos separada y desechable
# (test/global-setup.ts la recrea desde cero antes de correr los tests).
NODE_ENV=test
PORT=3001

CORS_ORIGINS=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nest_base_test

JWT_SECRET=e2e-test-secret
JWT_EXPIRATION=1h

BCRYPT_SALT_ROUNDS=4

SUPER_ADMIN_EMAIL=super-admin@example.com
SUPER_ADMIN_PASSWORD=SuperAdminPass123!

PASSWORD_RESET_EXPIRATION_MINUTES=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
