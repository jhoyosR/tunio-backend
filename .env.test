# Entorno para pruebas e2e: usa una base de datos separada y desechable
# (test/global-setup.ts la recrea desde cero antes de correr los tests).
NODE_ENV=test
PORT=3001

CORS_ORIGINS=http://localhost:4200

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tunio_test

TUNIO_TIMEZONE=America/Bogota
TUNIO_MAX_REQUESTS_PER_HOUR=5
TUNIO_BLOCK_DURATION_HOURS=4
TUNIO_SEARCH_CACHE_TTL_HOURS=24
TUNIO_YOUTUBE_DAILY_QUOTA=10000
TUNIO_YOUTUBE_QUOTA_RESERVE_PCT=20
TUNIO_EVENT_RETENTION_DAYS=180
