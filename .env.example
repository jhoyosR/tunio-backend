# Aplicacion
NODE_ENV=development
PORT=3000

# CORS: origenes permitidos separados por coma (ej: http://localhost:5173,http://localhost:4200)
CORS_ORIGINS=http://localhost:3000

# Base de datos (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nest_base

# Autenticacion JWT
JWT_SECRET=change-this-secret
JWT_EXPIRATION=1d

# Hashing de contrasenas
BCRYPT_SALT_ROUNDS=10

# Usuario super-admin sembrado por el seeder (sin defaults hardcodeados en el codigo)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Restablecimiento de contrasena
PASSWORD_RESET_EXPIRATION_MINUTES=30

# SMTP para envio de correo transaccional
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
