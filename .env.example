# Aplicacion
NODE_ENV=development
PORT=3000

# CORS: origenes permitidos separados por coma (la web Angular corre en 4200 en desarrollo)
CORS_ORIGINS=http://localhost:4200

# Base de datos (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tunio

# Autenticacion del personal. Genera un secreto propio de 32+ caracteres, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=12

# Constantes del servicio (docs/06 §5). Comunes a todos los establecimientos.
TUNIO_TIMEZONE=America/Bogota
TUNIO_MAX_REQUESTS_PER_HOUR=5
TUNIO_BLOCK_DURATION_HOURS=4
TUNIO_SEARCH_CACHE_TTL_HOURS=24
TUNIO_YOUTUBE_DAILY_QUOTA=10000
TUNIO_YOUTUBE_QUOTA_RESERVE_PCT=20
TUNIO_EVENT_RETENTION_DAYS=180
